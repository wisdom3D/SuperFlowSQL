API data ingestion pipeline - Generated by SuperFlowSQL CLI
"""
from __future__ import annotations

import pendulum
import pandas as pd
import requests
from airflow.decorators import dag, task
from airflow.providers.postgres.hooks.postgres import PostgresHook
from sqlalchemy import create_engine


TABLE_NAME = "{{ table_name }}"
POSTGRES_CONN_ID = "postgres_default"
API_URL = "https://jsonplaceholder.typicode.com/posts"  # Replace with your API


@dag(
    dag_id="{{ name }}",
    start_date=pendulum.datetime(2024, 1, 1, tz="UTC"),
    schedule={{ schedule }},
    catchup=False,
    tags=[{{ tags }}],
    doc_md=__doc__,
)
def pipeline():
    """{{ description }}"""

    @task
    def fetch_from_api():
        """Fetch data from API endpoint."""
        response = requests.get(API_URL, timeout=30)
        response.raise_for_status()
        data = response.json()
        print(f"Fetched {len(data)} records from API")
        return data

    @task
    def load_to_postgres(data):
        """Load API data into PostgreSQL."""
        df = pd.DataFrame(data)
        print(f"DataFrame: {len(df)} rows, columns: {df.columns.tolist()}")

        pg_hook = PostgresHook(postgres_conn_id=POSTGRES_CONN_ID)
        conn = pg_hook.get_connection(POSTGRES_CONN_ID)
        conn_uri = f"postgresql+psycopg2://{conn.login}:{conn.password}@{conn.host}:{conn.port}/{conn.schema}"
        engine = create_engine(conn_uri)

        df.to_sql(name=TABLE_NAME, con=engine, if_exists="replace", index=False)
        print(f"Loaded {len(df)} rows into {TABLE_NAME}")

    data = fetch_from_api()
    load_to_postgres(data)


pipeline()
