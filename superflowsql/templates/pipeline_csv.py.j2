"""
{{ description }}
CSV data ingestion pipeline - Generated by SuperFlowSQL CLI
"""
from __future__ import annotations

import pendulum
import pandas as pd
from airflow.decorators import dag, task
from airflow.providers.postgres.hooks.postgres import PostgresHook
from sqlalchemy import create_engine


TABLE_NAME = "{{ table_name }}"
POSTGRES_CONN_ID = "postgres_default"
CSV_PATH = "/opt/airflow/dags/data/input.csv"  # Update this path


@dag(
    dag_id="{{ name }}",
    start_date=pendulum.datetime(2024, 1, 1, tz="UTC"),
    schedule={{ schedule }},
    catchup=False,
    tags=[{{ tags }}],
    doc_md=__doc__,
)
def pipeline():
    """{{ description }}"""

    @task
    def read_csv():
        """Read data from CSV file."""
        df = pd.read_csv(CSV_PATH)
        print(f"Read {len(df)} rows from {CSV_PATH}")
        print(f"Columns: {df.columns.tolist()}")
        return df.to_dict()

    @task
    def load_to_postgres(data_dict):
        """Load CSV data into PostgreSQL."""
        df = pd.DataFrame(data_dict)
        print(f"Loading {len(df)} rows into {TABLE_NAME}")

        pg_hook = PostgresHook(postgres_conn_id=POSTGRES_CONN_ID)
        conn = pg_hook.get_connection(POSTGRES_CONN_ID)
        conn_uri = f"postgresql+psycopg2://{conn.login}:{conn.password}@{conn.host}:{conn.port}/{conn.schema}"
        engine = create_engine(conn_uri)

        df.to_sql(name=TABLE_NAME, con=engine, if_exists="replace", index=False)
        print(f"Loaded {len(df)} rows into {TABLE_NAME}")

    data = read_csv()
    load_to_postgres(data)


pipeline()
