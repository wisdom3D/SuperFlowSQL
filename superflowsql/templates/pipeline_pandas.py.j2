"""
{{ description }}
Pandas data ingestion pipeline - Generated by SuperFlowSQL CLI
"""
from __future__ import annotations

import pendulum
import pandas as pd
import numpy as np
from airflow.decorators import dag, task
from airflow.providers.postgres.hooks.postgres import PostgresHook
from sqlalchemy import create_engine


TABLE_NAME = "{{ table_name }}"
POSTGRES_CONN_ID = "postgres_default"


@dag(
    dag_id="{{ name }}",
    start_date=pendulum.datetime(2024, 1, 1, tz="UTC"),
    schedule={{ schedule }},
    catchup=False,
    tags=[{{ tags }}],
    doc_md=__doc__,
)
def pipeline():
    """{{ description }}"""

    @task
    def extract_and_load():
        """Extract data and load into PostgreSQL."""
        # Customize your data extraction logic here
        data = {
            "id": np.arange(1, 101),
            "value": np.random.random(100),
            "category": np.random.choice(["A", "B", "C"], size=100),
            "created_at": pd.Timestamp.now(),
        }
        df = pd.DataFrame(data)
        print(f"DataFrame created: {len(df)} rows")

        pg_hook = PostgresHook(postgres_conn_id=POSTGRES_CONN_ID)
        conn = pg_hook.get_connection(POSTGRES_CONN_ID)
        conn_uri = f"postgresql+psycopg2://{conn.login}:{conn.password}@{conn.host}:{conn.port}/{conn.schema}"
        engine = create_engine(conn_uri)

        df.to_sql(name=TABLE_NAME, con=engine, if_exists="replace", index=False)
        print(f"Loaded {len(df)} rows into {TABLE_NAME}")

    @task
    def verify():
        """Verify data was loaded."""
        pg_hook = PostgresHook(postgres_conn_id=POSTGRES_CONN_ID)
        count = pg_hook.get_first(f"SELECT COUNT(*) FROM {TABLE_NAME}")[0]
        print(f"Table {TABLE_NAME} has {count} rows")
        assert count > 0, "No data loaded!"

    extract_and_load() >> verify()


pipeline()
