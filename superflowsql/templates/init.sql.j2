-- SuperFlowSQL - Initial Database Schema
-- This file is executed when the PostgreSQL container first starts.

CREATE TABLE IF NOT EXISTS _superflowsql_meta (
    id SERIAL PRIMARY KEY,
    key TEXT UNIQUE NOT NULL,
    value TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

INSERT INTO _superflowsql_meta (key, value) VALUES
    ('project_name', '{{ project_name }}'),
    ('version', '0.1.0'),
    ('created_by', 'superflowsql-cli')
ON CONFLICT (key) DO NOTHING;
