# ============================================
# SuperFlowSQL - Environment Configuration
# ============================================

# --- PostgreSQL ---
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ postgres_password }}
POSTGRES_DB_AIRFLOW={{ postgres_db }}
POSTGRES_PORT={{ postgres_port }}
POSTGRES_HOST={{ postgres_host }}

# --- Airflow ---
AIRFLOW_USER={{ airflow_user }}
AIRFLOW_PASSWORD={{ airflow_password }}
AIRFLOW_EMAIL={{ airflow_email }}
AIRFLOW_PORT={{ airflow_port }}
AIRFLOW_FERNET_KEY={{ airflow_fernet_key }}
AIRFLOW_DB_CONN=postgresql+psycopg2://{{ postgres_user }}:{{ postgres_password }}@{{ postgres_host }}:{{ postgres_port }}/{{ postgres_db }}

# --- PgAdmin ---
PGADMIN_EMAIL={{ pgadmin_email }}
PGADMIN_PASSWORD={{ pgadmin_password }}
PGADMIN_PORT={{ pgadmin_port }}

# --- Superset ---
SUPERSET_USER={{ superset_user }}
SUPERSET_PASSWORD={{ superset_password }}
SUPERSET_EMAIL={{ superset_email }}
SUPERSET_PORT={{ superset_port }}
SUPERSET_SECRET_KEY={{ superset_secret_key }}
SUPERSET_DB_CONN=postgresql+psycopg2://{{ postgres_user }}:{{ postgres_password }}@{{ postgres_host }}:{{ postgres_port }}/{{ postgres_db }}
