# ==========================
# POSTGRESQL & SUPERSET DB
# ==========================
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB_AIRFLOW=airflow_db
POSTGRES_DB_SUPERSET=superset_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==========================
# PGADMIN
# ==========================
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=your_pgadmin_password
PGADMIN_PORT=5050

# ==========================
# AIRFLOW
# ==========================
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=your_airflow_password
AIRFLOW_EMAIL=admin@example.com
AIRFLOW_PORT=8080

# Generate a secure Fernet key before production use
AIRFLOW_FERNET_KEY=replace_with_secure_fernet_key

# Format:
# postgresql+psycopg2://<user>:<password>@<host>:<port>/<db>
AIRFLOW_DB_CONN=postgresql+psycopg2://your_postgres_user:your_postgres_password@postgres:5432/airflow_db

# ==========================
# SUPERSET
# ==========================
SUPERSET_PORT=8088
SUPERSET_USER=admin
SUPERSET_PASSWORD=your_superset_password
SUPERSET_EMAIL=admin@example.com
SUPERSET_SECRET_KEY=replace_with_secure_secret_key

# Format:
# postgresql+psycopg2://<user>:<password>@<host>:<port>/<db>
SUPERSET_DB_CONN=postgresql+psycopg2://your_postgres_user:your_postgres_password@postgres:5432/superset_db